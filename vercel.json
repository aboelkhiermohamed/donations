{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODE_OPTIONS": "--dns-result-order=ipv4first"
  },
  "crons": [
    {
      "path": "/api/internal/telegram-worker",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    }
  }
}
