# ==========================================
# 9th Batch Donation Platform - Environment Variables
# ==========================================

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------
# SMS Gateway Secret (Vodafone Cash / InstaPay SMS Webhook)
# ------------------------------------------
SMS_GATEWAY_API_KEY=your_secret_gateway_api_key_here

# ------------------------------------------
# Cloudflare R2 Storage (Direct-to-R2 Uploads & Receipts)
# ------------------------------------------
# Cloudflare Account ID (found on Cloudflare dashboard sidebar under R2 Overview)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 API Token with Object Read & Write permissions
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Name of the Cloudflare R2 bucket
R2_BUCKET_NAME=donations-receipts

# Optional: Custom domain or Cloudflare managed R2 domain if public assets are served directly
# Example: https://receipts.yourdomain.com (Leave empty if private bucket with presigned URLs)
R2_PUBLIC_DOMAIN=
